# ============================================================
# Configuration — factures-inpi
# Copiez ce fichier en « .env » puis complétez-le.
# Le fichier .env n'est JAMAIS versionné (voir .gitignore).
# ============================================================

# Identifiants du compte client INPI
# (ceux du formulaire de https://compte-client.inpi.fr)
INPI_USERNAME=
INPI_PASSWORD=

# Dossier où ranger les factures renommées
# (par défaut : Documents\Factures INPI de l'utilisateur courant)
#DOWNLOAD_DIR=C:\Chemin\Vers\Factures INPI

# Modèle de nom de fichier. Variables disponibles :
#   {date}      → date de l'opération au format AAAA-MM-JJ
#   {numero}    → n° de commande INPI
#   {refclient} → référence client saisie lors de la formalité
#   {type}      → Facture ou Remboursement
#   {montant}   → montant (ex : 72,61€)
FILENAME_PATTERN={date} - INPI - {type} {numero} - {refclient}.pdf

# Date de début de l'historique à récupérer (JJ/MM/AAAA)
#INPI_FROM_DATE=01/01/2010

# Base de l'extranet — ne pas toucher sauf changement de l'INPI
#INPI_BASE_URL=https://compte-client.inpi.fr/ExtranetCCL
